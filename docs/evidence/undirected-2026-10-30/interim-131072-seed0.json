  "definitions": {
    "eligible_pairs": "Actual boolean eligibility mask; initial+committed births-committed retirements.",
    "cumulative_births_deaths": "Committed activations and eligibility retirements, including repeat events; not unique pairs. Nonzero-to-zero retirements are counted separately.",
