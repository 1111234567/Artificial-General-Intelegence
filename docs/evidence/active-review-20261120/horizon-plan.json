  "payout": "\u56de\u8bbf\u5f53\u573a\u5b9e\u9645\u5f97\u5931\u548c\u771f\u5b9e\u540e\u7eed\u9009\u4fa7\u5404\u8ba1 \u00b11\uff0c\u4ee5\u603b\u548c\u4e3a\u540c\u4e00\u76ee\u6807\u3002\u540e\u56db\u6b21\u6b63\u5f0f\u9009\u4fa7\u7684\u884c\u52a8\u56de\u663e\u9010\u6b21\u8fdb\u5165\u540c\u4e00\u8eab\u4f53\uff0c\u8d44\u6e90\u5728\u5c40\u672b\u4ea4\u5272\uff0c\u8fc7\u7a0b\u4e2d\u6ca1\u6709\u65b0\u589e\u5473\u89c9\u6559\u5b66\u3002\u77ed\u5c40\u5176\u4f59\u56db\u65f6\u69fd\u63a8\u8fdb\u7b49\u65f6\u4e2d\u6027\u6d3b\u52a8\u3002\u4e24\u4e2a\u6c14\u5473\u5404\u5360\u4e24\u6b21\u540e\u7eed\u673a\u4f1a\uff0c\u5bf9\u5185\u5148\u540e\u968f\u673a\uff0c\u72ec\u7acb\u4e8e\u65e9\u671f\u5473\u89c9\u548c\u5019\u9009\u4f4d\u7f6e\u3002",
  "cue": "\u65e2\u6709\u590d\u4e60\u6a21\u5f0f\u4e24\u62cd\uff0c\u52a0\u4e09\u62cd\u5de6\u53f3\u7b49\u5411\u7b49\u5e45\u6c14\u5473\u3002\u4fe1\u606f\u7ec4\u8d1f\u53f7\u77ed\u5c40\u3001\u6b63\u53f7\u957f\u5c40\u3002\u540c\u5206\u5e03\u65e0\u4fe1\u606f\u7ec4\u5728\u6bcf\u7ec4\u4e24\u4e2a\u771f\u5b9e\u957f\u5ea6\u4e4b\u95f4\u7528\u72ec\u7acb\u968f\u673a\u76f8\u4f4d\u5bf9\u8c03\u6c14\u5473\u7b26\u53f7\uff0c\u4e24\u79cd\u957f\u5ea6\u3001\u4e24\u79cd\u7b26\u53f7\u4e0e\u673a\u4f1a\u96c6\u5408\u4fdd\u6301\u540c\u8fb9\u9645\u3002\u4e24\u7ec4\u7684\u524d\u53f2\u3001\u5b9e\u9645\u83dc\u5355\u3001\u771f\u5b9e\u56de\u8bbf\u3001\u540e\u7eed\u65f6\u69fd\u548c\u968f\u673a\u6570\u914d\u5bf9\u3002",
  "optimizer": "\u6bcf\u66f4\u65b0\u4ece\u540c\u4e00\u72b6\u6001\u5b8c\u6210\u4e24\u6761\u5b9e\u9645\u8def\u7ebf\uff0c\u7528\u4e24\u6761\u603b\u56de\u62a5\u4e4b\u5dee\u4e58\u53f3\u4fa7\u9009\u62e9\u6982\u7387\u7ed9\u539f\u751f\u8def\u7ebf\u52a8\u4f5c\u5206\u914d\u4fe1\u7528\u3002\u56de\u62a5\u4ece\u7269\u7406\u52a8\u4f5c\u8bfb\u51fa\uff0c\u6bcf\u6b65\u4f5c\u4e3a\u5e38\u91cf\uff0c\u51b3\u7b56\u6982\u7387\u7684\u68af\u5ea6\u7a7f\u8fc7\u540c\u4e00\u5957\u539f\u751f\u8109\u51b2\u4e0e\u65e9\u671f\u7269\u7406\u5199\u5165\u3002\u6b63\u8d1f\u8d44\u6e90\u6807\u51c6\u3001\u5b66\u4e60\u7387\u3001\u6279\u91cf\u3001\u8bc4\u4f30\u65f6\u949f\u53ca\u56de\u5408\u957f\u5ea6\u5206\u5e03\u5728\u4e24\u7ec4\u5185\u4e00\u81f4\u3002\u8bc4\u4f30\u4f7f\u7528\u4e00\u6b21\u672c\u673a\u8def\u7ebf\uff0c\u4e0d\u5411\u5b83\u8f93\u5165\u5f3a\u5236\u5206\u652f\u7ed3\u679c\u3002",
