  "primary": "\u6bcf\u6279 384 \u4e2a\u516c\u5171\u7559\u51fa\u51e0\u4f55\uff0c\u5404\u5b8c\u5168\u4ea4\u53c9\u4e24\u4efd\u4e92\u8865\u79c1\u6709\u6620\u5c04\u53ca\u4e24\u4e2a\u7f3a\u5473\u8eab\u4efd\u3002\u6bcf\u4e00\u6761\u5386\u53f2\u6d4b\u4e24\u4e2a\u7269\u7406 cue \u548c\u4e24\u6761\u771f\u6b63\u5b8c\u6210\u7684\u8def\u7ebf\u3002\u539f\u751f\u9009\u62e9\u4f7f\u7528\u5171\u540c\u8fd0\u52a8\u968f\u673a\u6570\u3002\u770b\u6bcf\u6279\u77ed\u5c40\u662f\u5426\u66f4\u591a\u56de\u5230\u5df2\u77e5\uff0c\u957f\u5c40\u662f\u5426\u66f4\u591a\u56de\u5230\u65e0\u5473\uff0c\u4ee5\u53ca\u4e24\u5c40\u9009\u65e0\u5473\u5dee\u662f\u5426\u8d85\u8fc7\u540c\u5206\u5e03\u65e0\u4fe1\u606f\u8bad\u7ec3\u7ec4\u3002\u7528\u6bcf\u4e2a\u771f\u5b9e\u671f\u9650\u548c\u7269\u7406\u6c14\u5473\u5bf9\u5e94\u7684\u5b9e\u9645\u53cd\u4e8b\u5b9e\u5206\u652f\uff0c\u6bd4\u8f83\u539f\u751f\u9009\u62e9\u3001\u5747\u5300\u3001\u56fa\u5b9a\u56de\u5df2\u77e5\u3001\u56fa\u5b9a\u56de\u65e0\u5473\u3001\u7528\u76f8\u53cd\u6c14\u5473\u4e0b\u7684\u52a8\u4f5c\u66ff\u6362\u3002\u7edf\u8ba1\u6bcf\u5c40\u603b\u8d44\u6e90\u3001\u56de\u8bbf\u5f53\u573a\u3001\u540e\u7eed\u5b9e\u9645\u6b63\u786e\u7387\u548c\u4e24\u8def\u7ebf\u7684\u5b9e\u9645\u5dee\u503c\u3002",
  "acceptance": "\u5171\u540c\u6700\u7ec8\u767b\u8bb0\u70b9\u5e94\u6709\u4e24\u6279\u5b9e\u9645\u9009\u65e0\u5473\u7684\u957f\u77ed\u5dee\u4e3a\u6b63\uff0c\u4fe1\u606f\u7ec4\u5dee\u51cf\u65e0\u4fe1\u606f\u7ec4\u5dee\u4e3a\u6b63\uff0c\u5e76\u67e5\u4e24\u6279\u6761\u4ef6\u9009\u62e9\u65b9\u5411\u53ca\u914d\u5bf9\u533a\u95f4\u3002\u603b\u8d44\u6e90\u987b\u5355\u72ec\u7ed9\u7f6e\u4fe1\u533a\u95f4\u3002\u82e5\u4e24\u8def\u7ebf\u5728\u65b0\u8eab\u4f53\u4e0a\u5931\u53bb\u77ed\u8d1f\u957f\u6b63\uff0c\u5206\u5f00\u62a5\u544a\u884c\u52a8\u5206\u5316\u548c\u5df2\u6539\u53d8\u7684\u884c\u52a8\u4ef7\u503c\uff0c\u4e0d\u501f\u8d77\u70b9\u6821\u51c6\u66ff\u4ee3\u7ec8\u70b9\u3002",
  "uncertainty": "\u914d\u5bf9\u540e\u5148\u5728\u51e0\u4f55\u5185\u5e73\u5747\u56db\u5386\u53f2\uff0c4,000 \u6b21\u4ea4\u53c9\u91cd\u62bd\u6837\u51fa\u751f\u4e0e\u516c\u5171\u51e0\u4f55\u3002\u5386\u53f2\u3001\u5f3a\u5236\u8def\u7ebf\u3001\u968f\u673a\u6570\u91cd\u590d\u5404\u4fdd\u7559\u5728\u539f\u51e0\u4f55\u5185\u3002\u672a\u88ab\u9009\u62e9\u7684\u771f\u5b9e\u53cd\u4e8b\u5b9e\u53ea\u7528\u5728\u57f9\u8bad\u7684\u914d\u5bf9\u4fe1\u7528\u548c\u8bc4\u4f30\u5bf9\u7167\u3002",
